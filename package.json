{
  "name": "associazione",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env:dev": "bash scripts/generate-env.sh dev",
    "env:prod": "bash scripts/generate-env.sh prod",
    "prestart": "npm run env:dev",
    "start": "node -e \"const{networkInterfaces:n}=require('os');const i=Object.values(n()).flat().find(x=>x.family==='IPv4'&&!x.internal);console.log('\\n📱 Accesso da telefono: http://'+i?.address+':4200\\n')\" && ng serve --host 0.0.0.0",
    "prebuild": "npm run env:prod",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "@aptabase/web": "^0.5.0",
    "jsqr": "^1.4.0",
    "lucide-angular": "^1.0.0",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.25",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
